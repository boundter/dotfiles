#!/usr/bin/env python3
"""Print green bubbles for Codex/Kiro panes visibly waiting for their user.

Called by tmux's asynchronous #() status formatter, once per visible window.
No transcripts, agent configuration, persistent state, or pane input are used.
"""

import re
import subprocess
import sys


def run(*args):
    try:
        result = subprocess.run(
            args, capture_output=True, text=True, timeout=2, check=False
        )
        return result.stdout if result.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def agent_for_pane(command, tty):
    if command == "codex":
        return "codex"
    if command in {"kiro-cli", "kiro-cli-chat"}:
        return "kiro"
    if command not in {"node", "bun"}:
        return None

    # tmux may report the launcher rather than the native Codex executable.
    # Check only this terminal's processes; an unrelated Node app is not an agent.
    for line in run("ps", "-t", tty, "-o", "comm=,args=").splitlines():
        fields = line.strip().split(maxsplit=1)
        if not fields:
            continue
        name = fields[0]
        args = fields[1] if len(fields) > 1 else ""
        if name == "codex" or (
            name == "node" and re.search(r"/codex/bin/codex\.js(?:\s|$)", args)
        ):
            return "codex"
        if name in {"kiro-cli", "kiro-cli-chat"} or (
            name in {"node", "bun"}
            and re.search(r"/kiro-cli/tui\.js(?:\s|$)", args)
        ):
            return "kiro"
    return None


def waiting(agent, screen):
    # Inspect the live screen's footer, not scrollback or questions in prose.
    lines = [line.strip() for line in screen.splitlines() if line.strip()]
    tail = "\n".join(lines[-18:])
    footer = "\n".join(lines[-6:])
    if not tail:
        return False

    if agent == "kiro":
        # Subagent permissions use an aggregate approval panel while the parent
        # still says it is orchestrating. Count the pane, not pending requests.
        if (
            re.search(r"^(?:⚠\ufe0f?\s*)?\d+ tool approvals? pending$", tail, re.I | re.M)
            and re.search(
                r"^(?:[❯›>]\s*)?\(a\) Approve (?:all pending|once|these \d+ requests)$",
                footer, re.I | re.M,
            )
        ):
            return True
        # Kiro's permission picker has Allow/Deny choices and a select footer.
        # Require the live picker footer so old menus in output do not count.
        if (
            re.search(r"to navigate.*to select", footer, re.I)
            and re.search(r"^(?:[❯›>]\s+)?(?:Always )?Allow$", tail, re.I | re.M)
            and re.search(r"^(?:[❯›>]\s+)?(?:Always )?Deny$", tail, re.I | re.M)
        ):
            return True
        # Kiro 2.32's permission dialog remains visible while processing is paused.
        if re.search(r"\[y\]\s+allow once", footer, re.I) and re.search(
            r"\[n\]\s+deny", footer, re.I
        ):
            return True
        # Structured questions use a dedicated submit/navigation footer.
        if re.search(r"to navigate.*to submit", footer, re.I):
            return True
        # The placeholder changes to 'Kiro is working' during active turns.
        # Typed drafts hide the placeholder, so also recognize the input below
        # Kiro's status divider, provided no processing/queue hint is present.
        if re.search(r"Kiro is working|[Tt]ype to (?:steer|queue)|esc to cancel|ctrl\+c to cancel", tail):
            return False
        if re.search(r"^›\s+ask a question or describe a task\b", footer, re.M):
            return True
        return bool(
            re.search(r"^\S.* · .* · ", tail, re.M)
            and re.search(r"^›(?:\s|$)", footer, re.M)
            and re.search(r"/sessions to resume|/copy to clipboard", footer)
        )

    if agent == "codex":
        # Approval and structured-input dialogs replace the normal composer.
        if re.search(r"(?:enter|↵) to (?:confirm|submit)|press enter to send", footer, re.I):
            return True
        # Codex keeps an editable composer on screen while working. Its mere
        # presence must not mark a running agent as waiting.
        composers = [i for i, line in enumerate(lines) if re.match(r"^›(?:\s|$)", line)]
        if not composers:
            return False
        composer = composers[-1]
        status = "\n".join(lines[max(0, composer - 5):])
        if re.search(r"esc to interrupt|esc to cancel", status, re.I):
            return False
        return bool(re.search(r"\? for shortcuts", footer))
    return False


def waiting_panes(target):
    if not re.fullmatch(r"[@%]\d+", target):
        return []
    panes = run(
        "tmux", "list-panes", "-t", target, "-F",
        "#{pane_id}\t#{pane_index}\t#{pane_current_command}\t#{pane_tty}\t#{pane_dead}",
    )
    result = []
    for line in panes.splitlines():
        fields = line.split("\t")
        if len(fields) != 5:
            continue
        pane, index, command, tty, dead = fields
        if target.startswith("%") and pane != target:
            continue
        if dead == "1" or not re.fullmatch(r"%\d+", pane):
            continue
        agent = agent_for_pane(command, tty)
        if agent and waiting(agent, run("tmux", "capture-pane", "-p", "-t", pane)):
            result.append(index)
    return result


def main():
    pane_mode = len(sys.argv) == 3 and sys.argv[1] == "--pane"
    target = sys.argv[2] if pane_mode else sys.argv[1] if len(sys.argv) == 2 else ""
    panes = waiting_panes(target)
    if panes:
        bubbles = "●" * (1 if pane_mode else len(panes))
        print("#[push-default,fg=#a6da95]" + bubbles + "#[default,pop-default] ", end="")


if __name__ == "__main__":
    main()
