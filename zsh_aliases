openpdf () {
  okular "$1" 2>/dev/null &
  disown
}

openpic () {
  gwenview $1 2>/dev/null &
  disown
}

opentxt () {
  kate $1 2>/dev/null &
  disown
}

wvim() {
  local write_dir="$HOME/writing"

  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/alacritty-latte.toml"
  if ! tmux has-session -t write 2>/dev/null; then
    tmux new-session -d -s write -c "$write_dir" "NVIM_FLAVOUR=latte nvim"
  fi
  tmux set-environment -t write -g NVIM_FLAVOUR latte

 # latte bar for the write session
  tmux set-option -t write status-style "bg=#e6e9ef,fg=#4c4f69"
  tmux set-option -t write status-left "#[bg=#8839ef,fg=#dce0e8] write "
  tmux set-option -t write status-right "#[bg=#e6e9ef,fg=#4c4f69] %d %b %H:%M "
  tmux set-option -t write window-status-format " #I:#W "
  tmux set-option -t write window-status-current-format " #[bg=#bcc0cc,fg=#4c4f69] #I:#W "
  tmux set-option -t write window-status-style "bg=#e6e9ef,fg=#4c4f69"
  tmux set-option -t write window-status-current-style "bg=#bcc0cc,fg=#4c4f69,bold"
  tmux set-option -t write message-style "bg=#ccd0da,fg=#4c4f69"
  tmux set-option -t write pane-border-style "fg=#bcc0cc"
  tmux set-option -t write pane-active-border-style "fg=#8839ef"

  alacritty --config-file "$cfg" -e tmux attach -t write
}

alias send_notification="notify-send -a Konsole -h 'string:desktop-entry:org.kde.konsole' -t 5000"
